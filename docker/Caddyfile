{$APP_HOST} {
  encode zstd gzip

  handle /api/assistant/telegram/* {
    respond 404
  }

  handle /api/* {
    reverse_proxy 127.0.0.1:3000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
  }
}
