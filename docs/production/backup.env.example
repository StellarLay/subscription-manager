# Keep the real file only on the VPS as /opt/subsio/.env.backup (mode 0600).
# Use a private S3 bucket and a dedicated restic repository prefix.
RESTIC_REPOSITORY=s3:https://s3.twcstorage.ru/BUCKET_NAME/subsio-postgres
RESTIC_PASSWORD_FILE=/opt/subsio/.restic-password
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=ru-1
