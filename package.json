{
  "name": "subscription-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @subscription-manager/server --filter @subscription-manager/web run dev",
    "build": "pnpm run generate && pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run generate && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "generate": "pnpm run openapi:generate && pnpm --filter @subscription-manager/api-client run generate",
    "openapi:generate": "pnpm --filter @subscription-manager/server run openapi:generate",
    "db:generate": "pnpm --filter @subscription-manager/server run db:generate",
    "db:migrate": "pnpm --filter @subscription-manager/server run db:migrate",
    "db:seed": "pnpm --filter @subscription-manager/server run db:seed",
    "db:studio": "pnpm --filter @subscription-manager/server run db:studio",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
