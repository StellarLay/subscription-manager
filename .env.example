# Только локальная разработка: скопируйте в .env. Не используйте эти значения на VPS.

# PostgreSQL в локальном Docker Compose
POSTGRES_USER=subscription_manager
POSTGRES_PASSWORD=subscription_manager
POSTGRES_DB=subscription_manager
POSTGRES_PORT=54329

# Переменные для запуска API/Prisma непосредственно на Mac
DATABASE_URL=postgresql://subscription_manager:subscription_manager@localhost:54329/subscription_manager?schema=public
API_HOST=0.0.0.0
API_PORT=3000
API_EXPOSE_PORT=3002
WEB_ORIGIN=http://localhost:5173

# Telegram: для обычного локального запуска токен не нужен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SubsioAppBot
TELEGRAM_MINI_APP_URL=
TELEGRAM_AUTH_DEV_BYPASS=true
TELEGRAM_AUTH_MAX_AGE_SECONDS=600
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Прокси Vite при запуске фронта непосредственно на Mac
VITE_DEV_PROXY_TARGET=http://localhost:3002

# ИИ-помощник (необязательно; ключ только на сервере)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.timeweb.ai/v1
ASSISTANT_DISABLE_DAILY_LIMIT=false
ASSISTANT_BOT_TOKEN=
