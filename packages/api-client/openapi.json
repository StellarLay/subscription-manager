  "info": {
    "title": "Subscription Manager API",
    "description": "API for subscriptions, recurring payments and reminders",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected"
            ],
            "example": "connected"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-06T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "PaymentMethodResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Тинькофф Black"
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ]
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "nullable": true
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-17T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "createdAt"
        ]
      },
      "CreatePaymentMethodDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Тинькофф Black",
            "maxLength": 100,
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ],
            "example": "CARD"
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "pattern": "^\\d{4}$"
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "SubscriptionPaymentMethodDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Основная карта"
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ]
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ]
      },
      "SubscriptionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "YouTube Premium"
          },
          "category": {
            "type": "string",
            "example": "Развлечения",
            "nullable": true
          },
          "amount": {
            "type": "string",
            "example": "799.00",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ]
          },
          "nextChargeDate": {
            "type": "string",
            "example": "2026-09-15",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "CANCELLED",
              "ARCHIVED"
            ]
          },
          "paymentMethod": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SubscriptionPaymentMethodDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-06T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "currency",
          "billingPeriod",
          "nextChargeDate",
          "status",
          "createdAt"
        ]
      },
      "CreateSubscriptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "YouTube Premium",
            "maxLength": 160,
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "example": 799,
            "minimum": 0.01,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ],
            "example": "MONTH"
          },
          "nextChargeDate": {
            "type": "string",
            "example": "2026-09-15",
            "format": "date"
          },
          "category": {
            "type": "string",
            "example": "Развлечения",
            "maxLength": 64
          },
          "paymentMethodId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name",
          "amount",
          "currency",
          "billingPeriod",
          "nextChargeDate"
        ]
      },
      "UpdateSubscriptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "YouTube Premium",
            "maxLength": 160,
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "example": 799,
            "minimum": 0.01,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ],
            "example": "MONTH"
          },
          "nextChargeDate": {
            "type": "string",
            "example": "2026-09-15",
            "format": "date"
          },
          "category": {
            "type": "string",
            "example": "Развлечения",
            "maxLength": 64
          },
          "paymentMethodId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      }
    }
  }
}
