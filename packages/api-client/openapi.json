  "info": {
    "title": "Subsio API",
    "description": "API for subscriptions, recurring payments and reminders",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sm_session"
      }
    },
    "schemas": {
      "TelegramAuthDto": {
        "type": "object",
        "properties": {
          "initData": {
            "type": "string",
            "description": "Raw Telegram.WebApp.initData value"
          }
        },
        "required": [
          "initData"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "telegramId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id"
        ]
      },
      "ExchangeRatesResponseDto": {
        "type": "object",
        "properties": {
          "baseCurrency": {
            "type": "string",
            "example": "RUB"
          },
          "rates": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "example": {
              "EUR": 99.3304,
              "RUB": 1,
              "USD": 84.5093
            }
          },
          "effectiveDate": {
            "type": "string",
            "example": "2026-09-18",
            "format": "date"
          },
          "fetchedAt": {
            "type": "string",
            "example": "2026-09-18T09:00:00.000Z",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean",
            "example": false
          },
          "source": {
            "type": "string",
            "example": "CBR"
          }
        },
        "required": [
          "baseCurrency",
          "rates",
          "effectiveDate",
          "fetchedAt",
          "stale",
          "source"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected"
            ],
            "example": "connected"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-06T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Развлечения"
          },
          "color": {
            "type": "string",
            "example": "#ff9b66"
          },
          "icon": {
            "type": "string",
            "enum": [
              "CLOUD",
              "EDUCATION",
              "ENTERTAINMENT",
              "FINANCE",
              "HEALTH",
              "OTHER",
              "WORK"
            ]
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-17T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "icon",
          "createdAt"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Развлечения",
            "maxLength": 64,
            "minLength": 1
          },
          "color": {
            "type": "string",
            "example": "#ff9b66",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "icon": {
            "type": "string",
            "enum": [
              "CLOUD",
              "EDUCATION",
              "ENTERTAINMENT",
              "FINANCE",
              "HEALTH",
              "OTHER",
              "WORK"
            ],
            "example": "ENTERTAINMENT"
          }
        },
        "required": [
          "name",
          "color",
          "icon"
        ]
      },
      "PaymentMethodResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Тинькофф Black"
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ]
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "nullable": true
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-17T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "createdAt"
        ]
      },
      "CreatePaymentMethodDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Тинькофф Black",
            "maxLength": 100,
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ],
            "example": "CARD"
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "pattern": "^\\d{4}$"
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "SubscriptionPaymentMethodDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Основная карта"
          },
          "lastFour": {
            "type": "string",
            "example": "4242",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "CARD",
              "BANK_ACCOUNT",
              "WALLET",
              "OTHER"
            ]
          },
          "color": {
            "type": "string",
            "example": "#73ff5b",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ]
      },
      "SubscriptionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "YouTube Premium"
          },
          "category": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryResponseDto"
              }
            ]
          },
          "amount": {
            "type": "string",
            "example": "799.00",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ]
          },
          "interval": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "nextChargeDate": {
            "type": "string",
            "description": "Ближайшая дата по графику, а не подтверждение фактической оплаты",
            "example": "2026-09-15",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "CANCELLED",
              "ARCHIVED"
            ]
          },
          "paymentMethod": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SubscriptionPaymentMethodDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-06T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "currency",
          "billingPeriod",
          "interval",
          "nextChargeDate",
          "status",
          "createdAt"
        ]
      },
      "CreateSubscriptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "YouTube Premium",
            "maxLength": 160,
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "example": 799,
            "minimum": 0.01,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ],
            "example": "MONTH"
          },
          "interval": {
            "type": "number",
            "default": 1,
            "example": 30,
            "maximum": 3650,
            "minimum": 1
          },
          "nextChargeDate": {
            "type": "string",
            "example": "2026-09-15",
            "format": "date"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "paymentMethodId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "name",
          "amount",
          "currency",
          "billingPeriod",
          "nextChargeDate"
        ]
      },
      "UpdateSubscriptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "YouTube Premium",
            "maxLength": 160,
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "example": 799,
            "minimum": 0.01,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB",
              "USD",
              "EUR"
            ],
            "example": "RUB"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "WEEK",
              "MONTH",
              "QUARTER",
              "YEAR",
              "CUSTOM"
            ],
            "example": "MONTH"
          },
          "interval": {
            "type": "number",
            "default": 1,
            "example": 30,
            "maximum": 3650,
            "minimum": 1
          },
          "nextChargeDate": {
            "type": "string",
            "example": "2026-09-15",
            "format": "date"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "paymentMethodId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      }
    }
  }
}
